<Window x:Class="Cora.Windows.Menu.Cadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Usuário" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="#f0f0f0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Criar Conta" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Nome de Usuário" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" Height="30" Margin="0,0,0,15" Padding="5"/>
            
            <TextBlock Text="Senha" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Confirmar Senha" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtConfirmPassword" Height="30" Margin="0,0,0,20" Padding="5"/>
            
            <Button Content="Cadastrar" Height="35" Background="#28a745" Foreground="White" FontWeight="Bold" Click="BtnCadastrar_Click" Margin="0,0,0,10"/>
            <Button Content="Voltar" Height="35" Background="#6c757d" Foreground="White" FontWeight="Bold" Click="BtnVoltar_Click"/>
        </StackPanel>
    </Grid>
</Window>
