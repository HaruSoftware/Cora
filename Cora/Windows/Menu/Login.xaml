<Window x:Class="Cora.Windows.Menu.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cora.Windows.Menu"
        mc:Ignorable="d"
        Title="Login do sistema Cora" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="#f0f0f0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Faça login para acessar" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Usuário" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" Height="30" Margin="0,0,0,15" Padding="5"/>
            
            <TextBlock Text="Senha" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,20" Padding="5"/>
            
            <Button Content="Entrar" Height="35" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="BtnLogin_Click"/>
            
            <TextBlock HorizontalAlignment="Center" Margin="0,15,0,0">
                <Hyperlink Click="LinkCadastro_Click">Não possui conta? Cadastre-se</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
