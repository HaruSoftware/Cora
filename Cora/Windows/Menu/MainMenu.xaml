<Window x:Class="Cora.UI.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cora"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        mc:Ignorable="d"
        Title="Sistema Cora v0.1"
        Width="1024" Loaded="WindowLoaded" Height="768" WindowState="Maximized" MinWidth="800" MinHeight="600" >

    <Window.Resources>
        <Storyboard x:Key="MenuExpandAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Duration="0:0:0.3">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="48"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="200"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="MenuCollapseAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Duration="0:0:0.3">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="200"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="48"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ElementName=MenuGrid, Path=ActualWidth}"/>
            <ColumnDefinition Width="150*"/>
        </Grid.ColumnDefinitions>

        <Grid Name="VerticalMenu" Grid.Row="1" Background="#f3f3f3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="MenuGrid" Width="50" Grid.Column="0" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Padding="0" HorizontalAlignment="Left" Click="SetVerticalMenu" Margin="5" Style="{StaticResource NormalButton}" Width="35" Height="35" Background="#f3f3f3">
                    <fa:ImageAwesome Icon="Sliders" Width="20" Height="20" Foreground="#636e72"/>
                </Button>

                <Button Grid.Row="1" Uid="1" Name="FirstButton" HorizontalAlignment="Left" Margin="5" Width="35" Click="SetWindow" Height="35" Style="{StaticResource NormalButton}" Background="#f3f3f3" Padding="0">
                    <Grid Width="{Binding ElementName=FirstButton, Path=ActualWidth}">
                        <fa:ImageAwesome Icon="Tag" Width="23" Height="23" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="#636e72"/>
                        <TextBlock Margin="40,0,0,0" Text="ANÚNCIOS" FontSize="15" Grid.Column="1" VerticalAlignment="Center" Foreground="#636e72" FontFamily="Segoe UI Semibold" IsHitTestVisible="false"/>
                    </Grid>
                </Button>
                <Button Grid.Row="2" Uid="2" HorizontalAlignment="Left" Margin="5" Width="{Binding ElementName=FirstButton, Path=ActualWidth}" Click="SetWindow" Height="35" Style="{StaticResource NormalButton}" Background="#f3f3f3" Padding="0">
                    <Grid Width="{Binding ElementName=FirstButton, Path=ActualWidth}">
                        <fa:ImageAwesome Icon="Tag" Width="23" Height="23" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="#636e72"/>
                        <fa:ImageAwesome Icon="Plus" Width="14" Height="14" Margin="20,5,0,0" HorizontalAlignment="Left" Foreground="LightGreen"/>
                        <TextBlock Margin="40,0,0,0" Text="NOVO ANÚNCIO" FontSize="15" Grid.Column="1" VerticalAlignment="Center" Foreground="#636e72" FontFamily="Segoe UI Semibold" IsHitTestVisible="false"/>
                    </Grid>
                </Button>

                <Rectangle RadiusX="1" RadiusY="1" Name="CurrentPageMarker" Grid.Row="1" Margin="6,12,0,12" Width="3" Visibility="Visible" Fill="#0984e3" HorizontalAlignment="Left"/>
            </Grid>
        </Grid>

        <Frame Name="defaultFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="#FFEBEBEB"/>

        <Border Opacity="0" Name="NoteBorder" Visibility="Collapsed" Grid.ColumnSpan="2" Background="#ff7675" CornerRadius="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10">
            <TextBlock Name="NoteText" FontFamily="Segoe UI Semibold" FontSize="15" Foreground="#FF3C3C3C" TextWrapping="Wrap" MaxWidth="800" Margin="10"/>
        </Border>
    </Grid>

</Window>
